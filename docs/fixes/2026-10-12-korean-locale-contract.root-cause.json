{
  "schema_version": 3,
  "id": "2026-10-12-korean-locale-contract",
  "problem_type": "Supported locale extension leaves narrower type, renderer import and user-facing projection contracts",
  "symptom": "Typecheck rejects ko in MCP metadata and launcher callback types; renderer architecture checks reject importing the Electron host module; Korean consumers may otherwise receive Chinese projections. PR #3 CI also fails three independent test imports because locale data eagerly calls the host bridge.",
  "direct_cause": "The supported locale union was owned in a host module while renderer, MCP metadata, telemetry and notification consumers kept independent two-language types or projections.",
  "class_root": "The supported language list and normalization belong to a renderer-safe shared contract. Host state remains host-owned, and every display or persisted consumer must accept the canonical locale and explicitly project Korean. Resource dictionaries must remain host-independent data; host-specific projection is explicit only at i18n composition.",
  "affected_population": [
    "Korean app and MCP users",
    "Future added supported locales"
  ],
  "scope_paths": [
    "electron/desktopLocale.ts",
    "electron/capabilityCore/mcpProtocol.ts",
    "electron/capabilityCore/mcpLocaleText.ts",
    "electron/shared/contracts/locale.ts",
    "src/i18n/index.ts",
    "electron/productionRun/productionNotifications.ts",
    "electron/settings/telemetryIpc.ts",
    "electron/telemetry/telemetryEvents.ts",
    "electron/telemetry/telemetryOutbox.ts",
    "electron/capabilityCore/generationRecoveryProjection.ts",
    "electron/settings/portableConfig.ts",
    "electron/harness/context/agentContext.ts",
    "electron/capabilityCore/mcpToolResults.ts",
    "electron/capabilityCore/mcpToolErrorResults.ts",
    "electron/capabilityCore/mcpCredentialElicitation.ts",
    "electron/capabilityCore/mcpTrustDowngrade.ts",
    "electron/capabilityCore/mcpTimelineConfirmation.ts",
    "electron/capabilityCore/mcpDocumentConfirmation.ts",
    "src/i18n/resources.ts",
    "src/i18n/locales/ko/index.ts"
  ],
  "entry_points": [
    "App settings choose ko",
    "MCP launcher reads persisted ko preference",
    "tools/list projects titleByLocale metadata",
    "Background production notifications project the selected locale",
    "Telemetry IPC parses renderer-supplied locale metadata"
  ],
  "external_sources": [],
  "internal_only_reason": "The supported locale and tool metadata contracts belong to this repository; external documentation does not define Nomi supported languages.",
  "invariants": [
    "DesktopLocale is derived from SUPPORTED_LOCALES in electron/shared/contracts/locale.ts; renderer imports only that shared pure module, while desktopLocale owns host state.",
    "Localized MCP title lookup accepts the shared locale type, and missing optional external titles retain the provided English title instead of selecting Chinese for Korean.",
    "Launcher test injection accepts the same DesktopLocale as production.",
    "Korean recovery and production notifications change copy without changing retry, spending, deduplication or navigation policy.",
    "Telemetry accepts canonical ko without relabeling it zh-CN; event names and privacy consent behavior remain unchanged."
  ],
